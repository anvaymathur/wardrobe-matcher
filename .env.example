# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Database.
#   Local dev:  a SQLite file.
#   Production: your Turso database URL (libsql://...).
DATABASE_URL="file:./dev.db"

# Turso auth token — required in production, leave empty for the local file DB.
TURSO_AUTH_TOKEN=""

# Shared password that gates the whole site. If empty, the app is open (no login).
# Set this in production to keep your closet private.
APP_PASSWORD=""

# BLOB_READ_WRITE_TOKEN is injected automatically when you enable Vercel Blob
# storage on the project — no need to set it by hand. Without it, images are
# saved to the local /public/uploads folder (dev only).
