// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A signed-in person. Everything below is scoped to its owner.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  items       Item[]
  pairings    Pairing[]
  outfits     Outfit[]
  collections Collection[]
  plannedDays PlannedDay[]
  weekBlocks  PlannedWeekBlock[]
}

model Item {
  id        String   @id @default(uuid())
  name      String
  category  String // TOP | BOTTOM | OUTERWEAR | SHOES — validated in app code (SQLite has no enums)
  subtype   String // "t-shirt", "dress shirt", "shorts", "chinos"
  color     String?
  imagePath String? // uploaded file path/URL (optional until a photo is added)
  sourceUrl String? // store link, for v2 auto-image import
  notes     String?
  favorite  Boolean  @default(false)
  noRepeat  Boolean  @default(false) // deprecated/unused — superseded by PlannedWeekBlock
  createdAt DateTime @default(now())

  // Nullable so the migration is clean on existing rows; the app always sets it.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  pairingsA   Pairing[]        @relation("ItemA")
  pairingsB   Pairing[]        @relation("ItemB")
  outfits     OutfitItem[]
  collections CollectionItem[]
  plannedDays PlannedDayItem[]
  weekBlocks  PlannedWeekBlock[]

  @@index([userId])
}

model Pairing {
  id      String @id @default(uuid())
  itemA   Item   @relation("ItemA", fields: [itemAId], references: [id], onDelete: Cascade)
  itemAId String
  itemB   Item   @relation("ItemB", fields: [itemBId], references: [id], onDelete: Cascade)
  itemBId String
  tier    Int // 1 = best match, up to 3

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([itemAId, itemBId]) // a pair is stored once
  @@index([userId])
}

// A saved outfit: a free-form set of items (any categories).
model Outfit {
  id        String       @id @default(uuid())
  name      String
  notes     String?
  createdAt DateTime     @default(now())
  items     OutfitItem[]

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([userId])
}

model OutfitItem {
  id       String @id @default(uuid())
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String

  @@unique([outfitId, itemId]) // an item appears once per outfit
}

// A named subset of the wardrobe (e.g. "Japan Trip") that the closet, shuffle,
// and outfit-building can be scoped to.
model Collection {
  id        String           @id @default(uuid())
  name      String
  createdAt DateTime         @default(now())
  items     CollectionItem[]

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String

  @@unique([collectionId, itemId]) // an item appears once per collection
}

// A day in the weekly planner: what you plan to wear on a given date. The date
// is a plain "YYYY-MM-DD" calendar day (timezone-free); one plan per day.
model PlannedDay {
  id        String           @id @default(uuid())
  date      String
  note      String?
  createdAt DateTime         @default(now())
  items     PlannedDayItem[]

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([userId, date])
  @@index([userId])
}

model PlannedDayItem {
  id           String     @id @default(uuid())
  plannedDay   PlannedDay @relation(fields: [plannedDayId], references: [id], onDelete: Cascade)
  plannedDayId String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String

  @@unique([plannedDayId, itemId]) // an item appears once per day
}

// A "don't wear twice this week" flag set from the planner, scoped to one week
// (its Monday, "YYYY-MM-DD"). Blocks the item on the week's other days.
model PlannedWeekBlock {
  id     String @id @default(uuid())
  week   String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@unique([userId, week, itemId])
  @@index([userId])
}
